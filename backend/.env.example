# Valores de ejemplo: NO usar para desplegar sin reemplazarlos
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@HOST:PUERTO/postgres?sslmode=require
JWT_SECRET_KEY=REEMPLAZAR_POR_SECRETO_ALEATORIO_LARGO_Y_PRIVADO
JWT_ALGORITHM=HS256
CORS_ORIGINS=https://frontend.example.com
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
# TEST_DATABASE_URL solo en testing; nunca copiar datos reales a pruebas.
# SALESIA_REPORT_DIR requiere almacenamiento persistente privado; Railway efimero no es suficiente.
